rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Education resources collection and all subcollections (media_chunks, carousel_slides)
    match /education_resources/{resourceId} {
      allow read, write: if true;
      match /{subcollection=**} {
        allow read, write: if true;
      }
    }
    // Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }
    // App configuration, tombstones & metadata
    match /app_meta/{metaId} {
      allow read, write: if true;
    }
    // Catch-all
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
