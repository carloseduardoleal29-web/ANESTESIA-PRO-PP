rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar de validación de texto
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // Colección central de médicos registrados
    match /usuarios_anestesiapro/{userId} {
      // Permitir lectura a la aplicación y panel de administración
      allow read: if true;
      
      // Permitir creación de nuevo médico registrado
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.medicalId is string;
                    
      // Permitir actualización (ej: activación Plan Pro por el admin o actualización de rescate)
      allow update: if true;
      
      allow delete: if false;
    }

    // Regla global por defecto
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
