rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function incoming() {
      return request.resource.data;
    }

    // Colecciones de médicos registrados en AnestesiaPro
    match /usuarios_anestesiapro/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /registered_users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /medicos_registrados/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Colección de recursos de educación continua sincronizados
    match /education_resources/{resId} {
      allow read: if true;
      allow create, update, delete: if true;

      match /media_chunks/{chunkId} {
        allow read, write: if true;
      }
    }

    // Colección de notificaciones y difusiones push
    match /notificaciones_anestesiapro/{notifId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    match /notifications/{notifId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Colección de eventos de auditoría y actividad
    match /eventos_anestesiapro/{eventId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Metadatos globales y estadísticas
    match /app_meta/{metaId} {
      allow read, write: if true;
    }

    // Regla global por defecto: denegar cualquier otra ruta
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
