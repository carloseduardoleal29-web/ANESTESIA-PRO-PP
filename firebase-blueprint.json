{
  "entities": {
    "MedicoRegistrado": {
      "title": "MedicoRegistrado",
      "description": "Registered physician user profile in AnestesiaPro",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-\\.@]+$"
        },
        "fullName": {
          "type": "string",
          "maxLength": 150,
          "minLength": 2
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "maxLength": 50
        },
        "country": {
          "type": "string",
          "maxLength": 100
        },
        "registeredAt": {
          "type": "string",
          "maxLength": 50
        },
        "device": {
          "type": "string",
          "maxLength": 150
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["id", "fullName", "email", "registeredAt"]
    }
  },
  "firestore": {
    "/medicos_registrados/{medicoId}": {
      "schema": {
        "$ref": "MedicoRegistrado"
      },
      "description": "Collection of registered doctors/physicians"
    }
  }
}
