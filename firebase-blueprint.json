{
  "entities": {
    "MedicoRegistrado": {
      "title": "MedicoRegistrado",
      "description": "Registered physician user profile in AnestesiaPro",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "fullName": { "type": "string", "maxLength": 200 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 50 },
        "country": { "type": "string", "maxLength": 100 },
        "deviceInfo": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "fullName", "email", "country"]
    },
    "EducationResource": {
      "title": "EducationResource",
      "description": "Continuous education resource or reel in AnestesiaPro",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 300 },
        "category": { "type": "string", "maxLength": 100 },
        "summary": { "type": "string", "maxLength": 1000 },
        "type": { "type": "string", "maxLength": 50 },
        "date": { "type": "string", "maxLength": 50 }
      },
      "required": ["id", "title", "category"]
    }
  },
  "firestore": {
    "/medicos_registrados/{medicoId}": {
      "schema": "MedicoRegistrado",
      "description": "Collection of registered physicians"
    },
    "/education_resources/{resourceId}": {
      "schema": "EducationResource",
      "description": "Collection of continuous education resources and reels"
    }
  }
}
