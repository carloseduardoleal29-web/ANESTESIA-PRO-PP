<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <rect width="800" height="600" fill="#090d16" rx="16"/>

  <rect x="40" y="25" width="720" height="50" rx="10" fill="#111827" stroke="#334155" stroke-width="1.5"/>
  <text x="60" y="56" fill="#e11d48" font-size="16" font-weight="900" font-family="system-ui, sans-serif" letter-spacing="1.5">RESUCITACIÓN HEMOSTÁTICA Y ACCESOS VASCULARES</text>
  <rect x="620" y="37" width="120" height="26" rx="13" fill="#881337" stroke="#f43f5e" stroke-width="1"/>
  <text x="680" y="54" fill="#fecdd3" font-size="11" font-weight="bold" text-anchor="middle" font-family="monospace">CÓDIGO ROJO</text>

  <g transform="translate(50, 95)">
    <!-- 2 Large Bore IV Catheters -->
    <g transform="translate(0, 0)">
      <rect width="335" height="180" rx="12" fill="#1e1b4b" stroke="#6366f1" stroke-width="2"/>
      <rect width="335" height="35" rx="10" fill="#312e81"/>
      <text x="15" y="23" fill="#c7d2fe" font-size="13" font-weight="900" font-family="sans-serif">DOS VÍAS PERIFÉRICAS GRUESAS</text>
      <text x="15" y="60" fill="#ffffff" font-size="16" font-weight="bold" font-family="monospace">Calibre 14G o 16G</text>
      <text x="15" y="85" fill="#cbd5e1" font-size="11" font-family="sans-serif">Flujo máximo según ley de Poiseuille:</text>
      <text x="15" y="105" fill="#a5b4fc" font-size="11" font-family="monospace">• 14G: 240 a 300 mL/min</text>
      <text x="15" y="125" fill="#a5b4fc" font-size="11" font-family="monospace">• 16G: 180 a 200 mL/min</text>
      <text x="15" y="150" fill="#facc15" font-size="10.5" font-family="sans-serif">Evitar calibre 18G o 20G para transfusión rápida.</text>
    </g>

    <!-- Transfusion Protocol 1:1:1 -->
    <g transform="translate(365, 0)">
      <rect width="335" height="180" rx="12" fill="#3b0712" stroke="#e11d48" stroke-width="2"/>
      <rect width="335" height="35" rx="10" fill="#4c0519"/>
      <text x="15" y="23" fill="#fecdd3" font-size="13" font-weight="900" font-family="sans-serif">PROTOCOLO DE TRANSFUSIÓN MASIVA</text>
      <text x="15" y="60" fill="#ffffff" font-size="18" font-weight="900" font-family="monospace">Ratio 1 : 1 : 1</text>
      <text x="15" y="85" fill="#fda4af" font-size="11" font-family="sans-serif">1 Concentrado de Glóbulos Rojos (CGR)</text>
      <text x="15" y="105" fill="#fda4af" font-size="11" font-family="sans-serif">1 Plasma Fresco Congelado (PFC)</text>
      <text x="15" y="125" fill="#fda4af" font-size="11" font-family="sans-serif">1 Pool de Plaquetas (o 1 Aféresis)</text>
      <text x="15" y="150" fill="#fde047" font-size="10.5" font-weight="bold" font-family="sans-serif">+ Calentador de fluidos para evitar hipotermia.</text>
    </g>

    <!-- Temperature and Calcium Target -->
    <g transform="translate(0, 205)">
      <rect width="700" height="180" rx="12" fill="#111827" stroke="#334155" stroke-width="1.5"/>
      <text x="25" y="30" fill="#38bdf8" font-size="13" font-weight="900" font-family="sans-serif">CONTROL DE LA TRIADA LETAL Y CALCIO IÓNICO</text>
      
      <g transform="translate(25, 45)">
        <rect width="200" height="110" rx="8" fill="#1e293b" stroke="#475569" stroke-width="1"/>
        <text x="15" y="25" fill="#f87171" font-size="11" font-weight="bold" font-family="sans-serif">1. Hipotermia:</text>
        <text x="15" y="50" fill="#cbd5e1" font-size="10" font-family="sans-serif">Mantener T &gt; 36.0 °C</text>
        <text x="15" y="70" fill="#cbd5e1" font-size="10" font-family="sans-serif">Calentador de fluidos rápido</text>
        <text x="15" y="90" fill="#ef4444" font-size="10" font-family="sans-serif">La hipotermia inactiva enzimas de coagulación.</text>
      </g>

      <g transform="translate(250, 45)">
        <rect width="200" height="110" rx="8" fill="#1e293b" stroke="#475569" stroke-width="1"/>
        <text x="15" y="25" fill="#fbbf24" font-size="11" font-weight="bold" font-family="sans-serif">2. Calcio Iónico:</text>
        <text x="15" y="50" fill="#ffffff" font-size="10" font-weight="bold" font-family="monospace">Ca²⁺ &gt; 1.1 mmol/L</text>
        <text x="15" y="70" fill="#cbd5e1" font-size="10" font-family="sans-serif">El citrato quela el calcio.</text>
        <text x="15" y="90" fill="#f59e0b" font-size="10" font-family="sans-serif">1 g Cloruro de Calcio cada 4 U CGR.</text>
      </g>

      <g transform="translate(475, 45)">
        <rect width="200" height="110" rx="8" fill="#042f2e" stroke="#10b981" stroke-width="1.5"/>
        <text x="15" y="25" fill="#34d399" font-size="11" font-weight="bold" font-family="sans-serif">3. Fibrinógeno Meta:</text>
        <text x="15" y="50" fill="#ffffff" font-size="10" font-weight="bold" font-family="monospace">&gt; 200 mg/dL (&gt; 2 g/L)</text>
        <text x="15" y="70" fill="#cbd5e1" font-size="10" font-family="sans-serif">Si &lt; 200 mg/dL: Crioprecipitados</text>
        <text x="15" y="90" fill="#10b981" font-size="10" font-family="sans-serif">1 U crio por cada 10 kg de peso.</text>
      </g>
    </g>
  </g>

  <g transform="translate(40, 510)">
    <rect width="720" height="65" rx="10" fill="#1e293b" stroke="#334155" stroke-width="1.5"/>
    <text x="20" y="26" fill="#f43f5e" font-size="12" font-weight="900" font-family="sans-serif">REGLA FUNDAMENTAL DE LÍQUIDOS EN PREECLAMPSIA + HEMORRAGIA:</text>
    <text x="20" y="48" fill="#e2e8f0" font-size="11.5" font-family="sans-serif">Transfundir sangre y hemoderivados tempranos en lugar de ahogar a la paciente con 3 a 5 litros de cristaloides (evitar edema pulmonar fatal).</text>
  </g>
</svg>
