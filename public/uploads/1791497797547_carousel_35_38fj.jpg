<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 450" width="100%" height="100%">
  <rect width="600" height="450" fill="#020617" rx="12"/>
  <text x="300" y="28" fill="#38bdf8" font-size="15" font-weight="bold" text-anchor="middle" font-family="sans-serif">ECOGRAFÍA POCUS / ECO-FAST: HEMATOMA HEPÁTICO</text>
  <g transform="translate(50, 45)">
    <rect width="500" height="350" rx="10" fill="#0f172a" stroke="#0ea5e9" stroke-width="2"/>
    <!-- Liver parenchyma -->
    <path d="M 50 80 Q 250 50 450 120 L 450 300 Q 250 330 50 260 Z" fill="#1e293b"/>
    <!-- Subcapsular collection (Hematoma) -->
    <path d="M 60 90 Q 250 150 440 130 Q 250 80 60 90 Z" fill="#7f1d1d" stroke="#ef4444" stroke-width="3"/>
    <text x="250" y="115" fill="#fca5a5" font-size="13" font-weight="bold" text-anchor="middle">Hematoma Subcapsular &gt; 8 cm</text>
    <!-- Capsule rupture -->
    <line x1="320" y1="120" x2="370" y2="170" stroke="#f43f5e" stroke-width="3" stroke-dasharray="4 2"/>
    <text x="370" y="195" fill="#f43f5e" font-size="12" font-weight="bold">Rotura Cápsula Glisson</text>
    <!-- Free fluid (hemoperitoneum) -->
    <ellipse cx="200" cy="270" rx="90" ry="30" fill="#0284c7" fill-opacity="0.5"/>
    <text x="200" y="275" fill="#e0f2fe" font-size="11" font-weight="bold" text-anchor="middle">Líquido Libre (Espacio de Morrison)</text>
  </g>
</svg>