<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <linearGradient id="massageGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#9f1239"/>
      <stop offset="100%" stop-color="#4c0519"/>
    </linearGradient>
  </defs>

  <rect width="800" height="600" fill="#090d16" rx="16"/>

  <rect x="40" y="25" width="720" height="50" rx="10" fill="#111827" stroke="#334155" stroke-width="1.5"/>
  <text x="60" y="56" fill="#f43f5e" font-size="16" font-weight="900" font-family="system-ui, sans-serif" letter-spacing="1.5">MANIOBRA DE COMPRESIÓN BEMANUAL UTERINA (HAMILTON)</text>
  <rect x="620" y="37" width="120" height="26" rx="13" fill="#881337" stroke="#f43f5e" stroke-width="1"/>
  <text x="680" y="54" fill="#ffe4e6" font-size="11" font-weight="bold" text-anchor="middle" font-family="monospace">MANIOBRA FÍSICA</text>

  <!-- Illustration of Bimanual Compression -->
  <g transform="translate(160, 95)">
    <!-- Abdominal Wall -->
    <path d="M 10 100 Q 240 70 460 100" stroke="#fbcfe8" stroke-width="6" fill="none"/>
    <text x="380" y="85" fill="#f472b6" font-size="11" font-family="sans-serif">Pared Abdominal Anterior</text>

    <!-- External Hand (Abdominal Palpation & Posterior Wall Compression) -->
    <g transform="translate(180, 20)">
      <rect x="0" y="0" width="160" height="70" rx="14" fill="#fed7aa" stroke="#f97316" stroke-width="2.5"/>
      <text x="80" y="38" fill="#7c2d12" font-size="12" font-weight="900" font-family="sans-serif" text-anchor="middle">MANO ABDOMINAL</text>
      <text x="80" y="55" fill="#9a3412" font-size="10" font-family="sans-serif" text-anchor="middle">Comprime Cara Posterior</text>
      <path d="M 80 70 L 80 110" stroke="#ea580c" stroke-width="4" marker-end="url(#arrow)" stroke-dasharray="3,3"/>
    </g>

    <!-- Compressed Uterus -->
    <ellipse cx="260" cy="210" rx="120" ry="85" fill="url(#massageGrad)" stroke="#fda4af" stroke-width="3"/>
    <text x="260" y="205" fill="#ffffff" font-size="14" font-weight="900" font-family="sans-serif" text-anchor="middle">ÚTERO ATONICO</text>
    <text x="260" y="225" fill="#fecdd3" font-size="11" font-weight="bold" font-family="sans-serif" text-anchor="middle">Compresión Mecánica Firme</text>

    <!-- Internal Hand (Vaginal Fist in Anterior Fornix) -->
    <g transform="translate(180, 310)">
      <rect x="0" y="0" width="160" height="70" rx="14" fill="#fed7aa" stroke="#f97316" stroke-width="2.5"/>
      <text x="80" y="38" fill="#7c2d12" font-size="12" font-weight="900" font-family="sans-serif" text-anchor="middle">MANO VAGINAL (PUÑO)</text>
      <text x="80" y="55" fill="#9a3412" font-size="10" font-family="sans-serif" text-anchor="middle">Fondo de Saco Anterior</text>
      <path d="M 80 0 L 80 -35" stroke="#ea580c" stroke-width="4" stroke-dasharray="3,3"/>
    </g>
  </g>

  <!-- Explanation Footer -->
  <g transform="translate(40, 510)">
    <rect width="720" height="65" rx="10" fill="#1e293b" stroke="#334155" stroke-width="1.5"/>
    <text x="20" y="26" fill="#f43f5e" font-size="12" font-weight="900" font-family="sans-serif">OBJETIVO HEMOSTÁTICO INMEDIATO:</text>
    <text x="20" y="48" fill="#e2e8f0" font-size="11.5" font-family="sans-serif">Ocluir mecánicamente las arterias espirales (ligaduras vivas de Pinard) hasta que los uterotónicos comiencen su efecto farmacológico.</text>
  </g>
</svg>
