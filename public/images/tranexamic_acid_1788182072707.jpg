<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <rect width="800" height="600" fill="#090d16" rx="16"/>

  <rect x="40" y="25" width="720" height="50" rx="10" fill="#111827" stroke="#334155" stroke-width="1.5"/>
  <text x="60" y="56" fill="#38bdf8" font-size="16" font-weight="900" font-family="system-ui, sans-serif" letter-spacing="1.5">ÁCIDO TRANEXÁMICO (TXA) PRECOZ: ENSAYO WOMAN TRIAL</text>
  <rect x="620" y="37" width="120" height="26" rx="13" fill="#0369a1" stroke="#38bdf8" stroke-width="1"/>
  <text x="680" y="54" fill="#e0f2fe" font-size="11" font-weight="bold" text-anchor="middle" font-family="monospace">ANTIFIBRINOLÍTICO</text>

  <g transform="translate(60, 95)">
    <!-- Syringe and Ampoule Illustration -->
    <g transform="translate(40, 30)">
      <!-- Ampoule -->
      <rect x="20" y="40" width="40" height="120" rx="6" fill="#0284c7" stroke="#38bdf8" stroke-width="2"/>
      <rect x="30" y="20" width="20" height="20" rx="2" fill="#bae6fd"/>
      <line x1="30" y1="30" x2="50" y2="30" stroke="#f43f5e" stroke-width="2"/>
      <text x="40" y="90" fill="#ffffff" font-size="9" font-weight="bold" text-anchor="middle" font-family="sans-serif">TXA</text>
      <text x="40" y="110" fill="#e0f2fe" font-size="8" font-family="monospace" text-anchor="middle">1 g / 10 mL</text>

      <!-- IV Infusion Line -->
      <path d="M 60 100 L 150 100" stroke="#38bdf8" stroke-width="4" stroke-dasharray="4,4"/>
      
      <!-- Syringe Infusion -->
      <rect x="150" y="80" width="140" height="40" rx="8" fill="#1e293b" stroke="#64748b" stroke-width="2"/>
      <rect x="150" y="85" width="90" height="30" rx="4" fill="#0ea5e9" opacity="0.6"/>
      <text x="220" y="105" fill="#f8fafc" font-size="11" font-weight="bold" font-family="sans-serif" text-anchor="middle">1 g en 100 mL SSN</text>
    </g>

    <!-- Key Timeline Bar (< 3 Horas) -->
    <g transform="translate(340, 20)">
      <rect width="320" height="160" rx="12" fill="#0c4a6e" stroke="#0284c7" stroke-width="2"/>
      <rect width="320" height="32" rx="10" fill="#075985"/>
      <text x="15" y="22" fill="#7dd3fc" font-size="12" font-weight="900" font-family="sans-serif">REGLA DE ORO DE LA PRIMERA HORA</text>
      <text x="15" y="60" fill="#ffffff" font-size="22" font-weight="900" font-family="monospace">&lt; 3 HORAS</text>
      <text x="15" y="85" fill="#bae6fd" font-size="11" font-family="sans-serif">Cada 15 minutos de retraso disminuye la eficacia en un 10%.</text>
      <text x="15" y="110" fill="#facc15" font-size="11" font-weight="bold" font-family="sans-serif">Dosis: 1 g IV en 10 minutos.</text>
      <text x="15" y="135" fill="#cbd5e1" font-size="10.5" font-family="sans-serif">Repetir 1 g si el sangrado continúa a los 30 min.</text>
    </g>

    <!-- Molecular Mechanism Visual -->
    <g transform="translate(40, 210)">
      <rect width="620" height="180" rx="12" fill="#111827" stroke="#334155" stroke-width="1.5"/>
      <text x="20" y="30" fill="#38bdf8" font-size="13" font-weight="900" font-family="sans-serif">MECANISMO MOLECULAR: BLOQUEO DE LA LISINA EN EL PLASMINÓGENO</text>
      
      <!-- Fibrin Mesh vs Plasmin -->
      <g transform="translate(30, 50)">
        <rect width="250" height="100" rx="8" fill="#1e293b" stroke="#475569" stroke-width="1"/>
        <text x="15" y="25" fill="#f87171" font-size="11" font-weight="bold" font-family="sans-serif">Sin Ácido Tranexámico:</text>
        <text x="15" y="50" fill="#cbd5e1" font-size="10" font-family="sans-serif">Plasmina degrada activamente el coágulo</text>
        <text x="15" y="70" fill="#cbd5e1" font-size="10" font-family="sans-serif">Hiperfibrinólisis local masiva</text>
        <text x="15" y="90" fill="#ef4444" font-size="10" font-weight="bold" font-family="sans-serif">Hemorragia persistente refractaria</text>
      </g>

      <g transform="translate(310, 50)">
        <rect width="280" height="100" rx="8" fill="#042f2e" stroke="#10b981" stroke-width="1.5"/>
        <text x="15" y="25" fill="#34d399" font-size="11" font-weight="bold" font-family="sans-serif">Con TXA Precoz (WOMAN Trial):</text>
        <text x="15" y="50" fill="#cbd5e1" font-size="10" font-family="sans-serif">Se une a los sitios de fijación de lisina</text>
        <text x="15" y="70" fill="#cbd5e1" font-size="10" font-family="sans-serif">Preserva la red de fibrina y el coágulo hemostático</text>
        <text x="15" y="90" fill="#10b981" font-size="10" font-weight="bold" font-family="sans-serif">Reduce muerte por hemorragia en 31%</text>
      </g>
    </g>
  </g>

  <!-- Evidence Footer -->
  <g transform="translate(40, 510)">
    <rect width="720" height="65" rx="10" fill="#1e293b" stroke="#334155" stroke-width="1.5"/>
    <text x="20" y="26" fill="#38bdf8" font-size="12" font-weight="900" font-family="sans-serif">EVIDENCIA DE SEGURIDAD TROMBÓTICA (20,060 MUJERES):</text>
    <text x="20" y="48" fill="#e2e8f0" font-size="11.5" font-family="sans-serif">El TXA NO aumenta el riesgo de trombosis venosa profunda, embolismo pulmonar ni infarto cerebral en el puerperio.</text>
  </g>
</svg>
