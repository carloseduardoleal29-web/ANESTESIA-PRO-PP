<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 600 450" width="100%" height="100%">
  <rect width="600" height="450" fill="#000000" rx="12"/>
  <text x="300" y="28" fill="#38bdf8" font-size="15" font-weight="bold" text-anchor="middle" font-family="sans-serif">RM CEREBRAL AXIAL T2 / FLAIR: SÍNDROME PRES</text>
  <!-- Skull & Brain Silhouette -->
  <ellipse cx="300" cy="235" rx="180" ry="195" fill="#18181b" stroke="#3f3f46" stroke-width="4"/>
  <ellipse cx="300" cy="235" rx="160" ry="175" fill="#27272a"/>
  <!-- Hemispheres midline -->
  <line x1="300" y1="65" x2="300" y2="405" stroke="#09090b" stroke-width="3"/>
  <!-- Ventricles -->
  <path d="M 285 200 C 275 220 275 260 288 280 M 315 200 C 325 220 325 260 312 280" stroke="#09090b" stroke-width="8" stroke-linecap="round" fill="none"/>
  <!-- Bilateral occipito-parietal vasogenic edema (hyperintense FLAIR) -->
  <ellipse cx="230" cy="330" rx="55" ry="40" fill="#ffffff" fill-opacity="0.85" filter="drop-shadow(0 0 12px #ffffff)"/>
  <ellipse cx="370" cy="330" rx="55" ry="40" fill="#ffffff" fill-opacity="0.85" filter="drop-shadow(0 0 12px #ffffff)"/>
  <!-- Annotations -->
  <text x="300" y="380" fill="#f43f5e" font-size="12" font-weight="bold" text-anchor="middle" font-family="sans-serif">Hiperintensidad parieto-occipital simétrica (Edema PRES)</text>
  <text x="300" y="425" fill="#a1a1aa" font-size="11" text-anchor="middle" font-family="sans-serif">Patognomónico de Encefalopatía Hipertensiva en Eclampsia</text>
</svg>